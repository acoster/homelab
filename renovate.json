{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Zurich",
  "schedule": ["before 8am on saturday"],
  "automergeSchedule": ["after 8pm", "before 8am"],
  "packageRules": [
    {
      "description": "Group minor and patch Docker updates together into a single weekly PR",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Homelab minor/patch updates"
    },
    {
      "description": "Separate major versions for manual inspection and changelog review",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "labels": ["major-upgrade"]
    },
    {
      "description": "Track CrowdSec Debian releases while preserving the v-prefix and -debian suffix",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["crowdsecurity/crowdsec", "*crowdsec*"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>-debian)$"
    },
    {
      "matchPackageNames": ["ghcr.io/maziggy/bambuddy", "maziggy/bambuddy"],
      "versioning": "loose"
    },
    {
      "matchPackageNames": ["*bambu-studio-api*"],
      "versioning": "loose",
      "extractVersion": "^bambuddy-(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/lidarr"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)(?:-ls(?<revision>\\d+))?$"
    },
    {
      "matchPackageNames": ["homebridge/homebridge"],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    },
    {
      "description": "Automerge digest updates once CI passes",
      "matchUpdateTypes": ["digest"],
      "schedule": ["at any time"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Infra that must not restart during the day (DNS, ingress, auth, deployer) merges only overnight",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "technitium/dns-server",
        "traefik",
        "ghcr.io/jittering/traefik-kop",
        "ghcr.io/tecnativa/docker-socket-proxy",
        "redis",
        "crowdsecurity/crowdsec",
        "ghcr.io/goauthentik/*",
        "ghcr.io/kimdre/doco-cd"
      ],
      "automergeSchedule": ["* 0-3 * * *"]
    },
    {
      "description": "GitHub Actions digests stay weekly and are not automerged",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "schedule": ["before 8am on saturday"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Traefik plugins pinned in traefik.toml",
      "managerFilePatterns": ["/(^|/)traefik\\.toml$/"],
      "matchStrings": [
        "moduleName = \"github\\.com/(?<depName>[^\"]+)\"\\s+version = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
