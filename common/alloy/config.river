// Shared by every host's alloy (common/compose.monitoring.yaml).
// Per-host: VLOGS_URL, the VictoriaLogs base URL, set in the host's compose file.

// Host metrics (CPU, memory, load, filesystems, temperatures, uptime).
// Not pushed: VictoriaMetrics scrapes them from this alloy's own HTTP server at
// /api/v0/component/prometheus.exporter.unix.host/metrics (job "node" in
// hosts/raspberry/monitoring/scrape.yml). The host root is mounted at /host and
// the container shares the host PID namespace (see common/compose.monitoring.yaml).
prometheus.exporter.unix "host" {
  rootfs_path = "/host"
  // Only what is useful on these boxes; the default set is much larger.
  set_collectors = [
    "cpu",
    "diskstats",
    "filesystem",
    "hwmon",
    "loadavg",
    "meminfo",
    "os",
    "stat",
    "thermal_zone",
    "time",
    "uname",
  ]
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal_syslog_identifier"]
    // Synology DSM noise; these identifiers never appear on the Pis.
    regex         = "synonetd|synologrotate"
    action        = "drop"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  // Container name, only set when the entry came from a container
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "(.+)"
    target_label  = "container"
  }

  // syslog_identifier only for non-container entries.
  // For containers it is the short container ID, which just adds noise.
  rule {
    source_labels = ["__journal_container_name", "__journal_syslog_identifier"]
    separator     = ";"
    regex         = ";(.+)"
    target_label  = "syslog_identifier"
  }
}

loki.source.journal "host" {
  path          = "/run/log/journal"
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "systemd-journal" }
  forward_to    = [loki.process.drop_empty.receiver]
}

loki.process "drop_empty" {
  stage.drop {
    expression          = "^\\s*$"
    drop_counter_reason = "empty_message"
  }
  forward_to = [loki.write.victorialogs.receiver]
}

loki.write "victorialogs" {
  endpoint {
    url = sys.env("VLOGS_URL") + "/insert/loki/api/v1/push?_msg_field=msg,message,event"
  }
}
