root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# shfmt reads these (https://github.com/mvdan/sh/blob/master/cmd/shfmt/shfmt.1.scd)
[*.sh]
space_redirects = true
binary_next_line = true
