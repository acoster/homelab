loki.source.journal "pi_ram_logs" {
  forward_to = [loki.relabel.docker_journal.receiver]
}

loki.relabel "docker_journal" {
  forward_to = [loki.write.victorialogs.receiver]

  // Extract Docker container name
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container_name"
  }
  
  // Extract the Pi's hostname
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
}

loki.write "victorialogs" {
  endpoint {
    url = "http://192.168.1.212:9428/insert/loki/api/v1/push"
  }
}
