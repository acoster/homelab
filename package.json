{
  "name": "homelab",
  "private": true,
  "description": "Formatting and lint tooling only; nothing here is deployed.",
  "scripts": {
    "format": "dclint -r --fix . && prettier --write .",
    "lint": "prettier --check . && dclint -r .",
    "format:sh": "shfmt -w hosts",
    "lint:sh": "shfmt -d hosts"
  },
  "devDependencies": {
    "dclint": "3.1.0",
    "prettier": "3.10.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
